{
  "expo": {
    "name": "Spendly",
    "slug": "spendly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0C",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0A0A0C"
    },
    "android": {
      "package": "com.aylinsarioglu.spendly",
      "versionCode": 1,
      "backgroundColor": "#0A0A0C",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0A0C"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0C"
      }
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0A0C",
            "image": "./assets/splash.png"
          },
          "android": {
            "backgroundColor": "#0A0A0C",
            "image": "./assets/splash.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          },
          "ios": {
            "backgroundColor": "#0A0A0C",
            "image": "./assets/splash.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Spendly uygulama kilidini açmak için Face ID kullanır."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cf0762e6-3e8b-40d6-967c-0107515f7b5c"
      }
    },
    "owner": "ayl1n"
  }
}
